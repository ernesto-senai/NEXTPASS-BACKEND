# Copie para .env e ajuste os valores.

NODE_ENV=development
PORT=3333

# Banco (docker compose up db sobe um Postgres com estes dados). Publicado: a URL do
# Supabase (botão Connect, Session pooler) com ?sslmode=require no fim.
DATABASE_URL=postgresql://nextpass:nextpass@localhost:5432/nextpass?schema=public

# Segredo do token de acesso (RNF-07). Gere um longo, ex.: openssl rand -base64 48
JWT_ACCESS_SECRET=troque-este-segredo-de-acesso-com-32-caracteres-ou-mais
JWT_ACCESS_EXPIRES_IN=15m

# Endereço do app no link de vínculo com o responsável (aparece no terminal da API).
# No navegador: http://localhost:8081. Publicado: o endereço do app web no Render.
APP_URL=http://localhost:8081

# Origens liberadas no CORS, separadas por vírgula (o app nativo não usa CORS).
# Publicado: o endereço do app web no Render.
CORS_ORIGINS=http://localhost:8081

# Onde ficam lances, fotos e documentos. "local": pasta uploads deste computador.
# "s3": Supabase Storage (ou R2/S3), para todos os aparelhos verem os mesmos arquivos.
STORAGE_DRIVER=local
# Com STORAGE_DRIVER=s3, copie do Supabase (configurações de Storage, S3 Connection):
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BUCKET=nextpass-publico
S3_PRIVATE_BUCKET=nextpass-privado
# Endereço público: https://<projeto>.supabase.co/storage/v1/object/public/nextpass-publico
S3_PUBLIC_URL=

# Conta de administrador criada pelo seed (npm run db:seed). Rodar o seed de
# novo atualiza a senha para a deste arquivo.
ADMIN_EMAIL=admin@nextpass.app
ADMIN_PASSWORD=demo12345
