# Copie para .env e ajuste os valores.

NODE_ENV=development
PORT=3333

# Banco (docker compose up db sobe um Postgres com estes dados)
DATABASE_URL=postgresql://nextpass:nextpass@localhost:5432/nextpass?schema=public

# Token de acesso JWT (RNF-07): gere um segredo longo, por exemplo com
# openssl rand -base64 48. O token de atualização é aleatório e fica no banco
# como hash; a validade dele depende do "Lembrar de mim" (RF-03).
JWT_ACCESS_SECRET=troque-este-segredo-de-acesso-com-32-caracteres-ou-mais
JWT_ACCESS_EXPIRES_IN=15m

# Endereço do app nos links dos e-mails (nova senha e vínculo com o
# responsável). No navegador: http://localhost:8081. No celular: nextpass://
APP_URL=http://localhost:8081

# Origens liberadas no CORS, separadas por vírgula (o app nativo não usa CORS)
CORS_ORIGINS=http://localhost:8081

# E-mail de verdade (nova senha e vínculo com o responsável). Deixe SMTP_HOST
# vazio para o e-mail aparecer no terminal da API. Com o Gmail: ative a
# verificação em duas etapas e crie uma "senha de app" (16 letras) em
# https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=NextPass <seu-email@gmail.com>

# Conta de administrador criada pelo seed (npm run db:seed). Rodar o seed de
# novo atualiza a senha para a deste arquivo.
ADMIN_EMAIL=admin@nextpass.app
ADMIN_PASSWORD=demo12345
